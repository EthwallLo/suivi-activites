<Window x:Class="MonTableurApp.Views.EditEssaiPlanningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuration de l'essai"
        Width="520"
        Height="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="EditorLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="3,0,0,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>

        <Style x:Key="EditorTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SearchInputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SearchInputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SearchInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="98"/>
            <Setter Property="Background" Value="{DynamicResource ThemeButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeButtonForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlanningCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="CheckBorder"
                                    Width="22"
                                    Height="22"
                                    Background="{DynamicResource SearchInputBackgroundBrush}"
                                    BorderBrush="{DynamicResource SearchInputBorderBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="11"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="CheckMark"
                                           Text="&#xE73E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"
                                           Foreground="{DynamicResource PrimaryTitleBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0"/>
                            </Border>

                            <ContentPresenter Grid.Column="1"
                                              Margin="9,0,0,0"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource MenuButtonPressedBackgroundBrush}"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource MenuButtonHoverBorderBrush}"/>
                                <Setter TargetName="CheckMark" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource MenuButtonHoverBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="22"
            Padding="22"
            Background="#FFFFFF"
            BorderBrush="{DynamicResource DataGridSurfaceBorderBrush}"
            BorderThickness="1"
            CornerRadius="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="TitleTextBlock"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTitleBrush}"/>
                <TextBlock x:Name="SubtitleTextBlock"
                           Margin="0,5,0,0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,18,0,0"
                    Padding="12"
                    Background="{DynamicResource SummaryCardBackgroundBrush}"
                    BorderBrush="{DynamicResource SummaryCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <TextBlock x:Name="DefaultSummaryTextBlock"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SummaryValueBrush}"
                           TextWrapping="Wrap"/>
            </Border>

            <Grid Grid.Row="2"
                  Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Mise en place (h)"
                               Style="{StaticResource EditorLabelStyle}"/>
                    <TextBox x:Name="SetupDurationTextBox"
                             Style="{StaticResource EditorTextBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="0,0,10,0">
                    <TextBlock Text="Essai (h)"
                               Style="{StaticResource EditorLabelStyle}"/>
                    <TextBox x:Name="TestDurationTextBox"
                             Style="{StaticResource EditorTextBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Reprise (h)"
                               Style="{StaticResource EditorLabelStyle}"/>
                    <TextBox x:Name="RecoveryDurationTextBox"
                             Style="{StaticResource EditorTextBoxStyle}"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="3"
                        Margin="0,18,0,0">
                <CheckBox x:Name="BackgroundCheckBox"
                          Style="{StaticResource PlanningCheckBoxStyle}"
                          Content="Essai en arrière-plan"
                          FontSize="13"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource PrimaryTitleBrush}"/>
                <TextBlock x:Name="StatusTextBlock"
                           Margin="0,14,0,0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <WrapPanel Grid.Row="4"
                       HorizontalAlignment="Right">
                <Button Content="Par défaut"
                        Style="{StaticResource DialogButtonStyle}"
                        Click="Reset_Click"/>
                <Button Content="Annuler"
                        Style="{StaticResource DialogButtonStyle}"
                        Click="Cancel_Click"/>
                <Button Content="Enregistrer"
                        Style="{StaticResource DialogButtonStyle}"
                        Click="Save_Click"/>
            </WrapPanel>
        </Grid>
    </Border>
</Window>
