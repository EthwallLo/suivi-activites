<UserControl x:Class="MonTableurApp.Views.VueAgendaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             PreviewKeyDown="VueAgendaView_PreviewKeyDown">

    <UserControl.Resources>
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DataGridSurfaceBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="24"/>
        </Style>

        <Style x:Key="AgendaTaskCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Background" Value="{DynamicResource SearchCardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SearchCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="TimelineTaskCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Background" Value="{DynamicResource SummaryCardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SummaryCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource SearchInputForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SearchInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SearchInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimeEditTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource RoundedTextBoxStyle}">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="InvisibleRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CuteThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Background="{DynamicResource ScrollThumbBrush}"
                                CornerRadius="8"
                                Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Border x:Name="TrackBorder"
                                    Background="{DynamicResource ScrollTrackBrush}"
                                    CornerRadius="8"/>
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="DecreaseButton"
                                                  Style="{StaticResource InvisibleRepeatButtonStyle}"
                                                  Command="ScrollBar.PageLeftCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource CuteThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="IncreaseButton"
                                                  Style="{StaticResource InvisibleRepeatButtonStyle}"
                                                  Command="ScrollBar.PageRightCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="TrackBorder" Property="Height" Value="12"/>
                                <Setter TargetName="TrackBorder" Property="Margin" Value="0,10,0,2"/>
                                <Setter Property="Height" Value="24"/>
                            </Trigger>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter TargetName="TrackBorder" Property="Width" Value="12"/>
                                <Setter TargetName="TrackBorder" Property="Margin" Value="2,0,0,0"/>
                                <Setter Property="Width" Value="16"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="True"/>
                                <Setter TargetName="DecreaseButton" Property="Command" Value="ScrollBar.PageUpCommand"/>
                                <Setter TargetName="IncreaseButton" Property="Command" Value="ScrollBar.PageDownCommand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AgendaSummaryPillStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{DynamicResource SummaryCardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SummaryCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style x:Key="CompactAgendaButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="{DynamicResource ThemeButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeButtonForegroundBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource MenuButtonHoverBackgroundBrush}"/>
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource MenuButtonHoverBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource MenuButtonPressedBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniAgendaButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactAgendaButtonStyle}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{DynamicResource SearchInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SearchInputBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTitleBrush}"/>
        </Style>

        <Style x:Key="AgendaCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="CheckBorder"
                                    Width="22"
                                    Height="22"
                                    Background="{DynamicResource SearchInputBackgroundBrush}"
                                    BorderBrush="{DynamicResource SearchInputBorderBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="11"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="CheckMark"
                                           Text="&#xE73E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"
                                           Foreground="{DynamicResource PrimaryTitleBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0"/>
                            </Border>

                            <ContentPresenter Grid.Column="1"
                                              Margin="9,0,0,0"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource MenuButtonPressedBackgroundBrush}"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource MenuButtonHoverBorderBrush}"/>
                                <Setter TargetName="CheckMark" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource MenuButtonHoverBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HourStripeStyle" TargetType="Border">
            <Setter Property="Height" Value="48"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DataGridSurfaceBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Background" Value="#FFFCFE"/>
        </Style>

        <Style x:Key="NonWorkingTimeBlockStyle" TargetType="Border">
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Background" Value="{DynamicResource DataGridRowSelectedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SearchInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,1"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource SectionCardStyle}"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="À planifier"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTitleBrush}"/>
                            <TextBlock Text="{Binding AgendaWeekTitle}"
                                       Margin="0,4,12,0"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Padding="10,6"
                                Background="{DynamicResource SummaryWarmBackgroundBrush}"
                                BorderBrush="{DynamicResource SummaryWarmBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                VerticalAlignment="Top">
                            <TextBlock Text="{Binding AgendaBacklogFilterSummary}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SummaryWarmForegroundBrush}"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1"
                          Margin="0,14,0,0">
                        <TextBox x:Name="AgendaSearchTextBox"
                                 Style="{StaticResource RoundedTextBoxStyle}"
                                 ToolTip="Filtrer les essais par projet, produit ou type d'essai"
                                 Text="{Binding AgendaSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Margin="12,0,34,0"
                                   Text="Filtrer..."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=AgendaSearchTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Text, ElementName=AgendaSearchTextBox}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="×"
                                Width="24"
                                Height="24"
                                Padding="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0"
                                ToolTip="Effacer le filtre"
                                Click="ClearAgendaSearch_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MiniAgendaButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAgendaSearch}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="2"
                          Margin="0,14,0,0">
                        <TextBlock Text="Tout est placé pour l'instant"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AgendaBacklogVisibleCount}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ListBox ItemsSource="{Binding AgendaBacklogVisibleTasks}"
                                 AllowDrop="True"
                                 Drop="Backlog_Drop"
                                 PreviewMouseMove="AgendaList_PreviewMouseMove">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource AgendaTaskCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Background="{DynamicResource InfoCardAccentBrush}"
                                                    CornerRadius="16,0,0,16"/>

                                            <StackPanel Grid.Column="1"
                                                        Margin="12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding NomEssai}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryTitleBrush}"
                                                               TextWrapping="Wrap"/>
                                                    <Border Grid.Column="1"
                                                            Padding="8,4"
                                                            Margin="8,0,0,0"
                                                            Background="{DynamicResource SummaryMintBackgroundBrush}"
                                                            BorderBrush="{DynamicResource SummaryMintBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding DureeLabel}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SummaryMintForegroundBrush}"/>
                                                    </Border>
                                                    <Button Grid.Column="2"
                                                            Content="Planifier"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Top"
                                                            Style="{StaticResource MiniAgendaButtonStyle}"
                                                            Click="PlanifierEssai_Click"/>
                                                </Grid>
                                                <TextBlock Text="{Binding NomProduit}"
                                                           Margin="0,4,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding NumeroProjet}"
                                                           Margin="0,2,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SummaryValueBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource SectionCardStyle}"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Agenda de travail"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTitleBrush}"/>
                            <TextBlock Text="{Binding AgendaWeekTitle}"
                                       Margin="0,3,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <WrapPanel Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center">
                            <Border Style="{StaticResource AgendaSummaryPillStyle}">
                                <TextBlock FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTitleBrush}">
                                    <Run Text="{Binding AgendaPlannedTaskCount, Mode=OneWay}"/>
                                    <Run Text=" placé(s)"/>
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource AgendaSummaryPillStyle}">
                                <TextBlock Text="{Binding AgendaPlannedDurationLabel}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SummaryValueBrush}"/>
                            </Border>
                            <Border Style="{StaticResource AgendaSummaryPillStyle}">
                                <TextBlock FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#D65C72">
                                    <Run Text="{Binding AgendaOverflowTaskCount, Mode=OneWay}"/>
                                    <Run Text=" à recaler"/>
                                </TextBlock>
                            </Border>
                            <Button Content="Annuler"
                                    Style="{StaticResource CompactAgendaButtonStyle}"
                                    IsEnabled="{Binding CanUndoAgenda}"
                                    Click="UndoAgenda_Click"/>
                        </WrapPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="2"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="Transparent"/>

                        <ItemsControl Grid.Column="1"
                                      ItemsSource="{Binding AgendaWeekDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,10,0"
                                            Padding="12"
                                            Background="#FBFDFF"
                                            BorderBrush="{DynamicResource DataGridSurfaceBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="20">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <TextBlock Text="{Binding DayLabel}"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryTitleBrush}"/>
                                                    <TextBlock Text="{Binding DateLabel}"
                                                               Margin="0,3,0,0"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            HorizontalAlignment="Right">
                                                    <Border Padding="7,3"
                                                            Background="{DynamicResource SummaryCardBackgroundBrush}"
                                                            BorderBrush="{DynamicResource SummaryCardBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="10">
                                                        <TextBlock FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SummaryValueBrush}">
                                                            <Run Text="{Binding PlannedTasks.Count, Mode=OneWay}"/>
                                                            <Run Text=" essai(s)"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <Border Margin="0,5,0,0"
                                                            Padding="7,3"
                                                            Background="{DynamicResource SummaryMintBackgroundBrush}"
                                                            BorderBrush="{DynamicResource SummaryMintBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="10">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="Aujourd'hui"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SummaryMintForegroundBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <CheckBox Content="Jour travaillé"
                                                      Margin="0,10,0,0"
                                                      IsChecked="{Binding IsWorkingDay, Mode=TwoWay}"
                                                      Style="{StaticResource AgendaCheckBoxStyle}"
                                                      FontSize="12"
                                                      FontWeight="SemiBold"
                                                      Foreground="{DynamicResource PrimaryTitleBrush}"/>

                                            <Grid Margin="0,10,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Début"
                                                           Margin="2,0,4,4"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="Fin"
                                                           Margin="6,0,2,4"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                                                <TextBox Grid.Row="1"
                                                         Margin="0,0,4,0"
                                                         Style="{StaticResource RoundedTextBoxStyle}"
                                                         Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBox Grid.Row="1"
                                                         Grid.Column="1"
                                                         Margin="4,0,0,0"
                                                         Style="{StaticResource RoundedTextBoxStyle}"
                                                         Text="{Binding EndTimeText, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>

                                            <CheckBox Content="Pause midi"
                                                      Margin="0,10,0,0"
                                                      IsChecked="{Binding IsLunchBreakEnabled, Mode=TwoWay}"
                                                      Style="{StaticResource AgendaCheckBoxStyle}"
                                                      FontSize="12"
                                                      FontWeight="SemiBold"
                                                      Foreground="{DynamicResource PrimaryTitleBrush}"/>

                                            <Grid Margin="0,8,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="De"
                                                           Margin="2,0,4,4"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="À"
                                                           Margin="6,0,2,4"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                                                <TextBox Grid.Row="1"
                                                         Margin="0,0,4,0"
                                                         Style="{StaticResource RoundedTextBoxStyle}"
                                                         Text="{Binding LunchStartText, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBox Grid.Row="1"
                                                         Grid.Column="1"
                                                         Margin="4,0,0,0"
                                                         Style="{StaticResource RoundedTextBoxStyle}"
                                                         Text="{Binding LunchEndText, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Grid.Row="2"
                                Grid.Column="0"
                                Height="{Binding AgendaTimelineHeight}"
                                Background="#FFF9FC"
                                BorderBrush="{DynamicResource DataGridSurfaceBorderBrush}"
                                BorderThickness="0,1,1,1"
                                CornerRadius="14,0,0,14">
                            <ItemsControl ItemsSource="{Binding AgendaDisplayHourMarkers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Height="{Binding DataContext.AgendaTimelineHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Top" Value="{Binding Offset}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}"
                                                   Width="46"
                                                   TextAlignment="Right"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <ItemsControl Grid.Row="2"
                                      Grid.Column="1"
                                      ItemsSource="{Binding AgendaWeekDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,10,0"
                                            Background="#FFFFFF"
                                            BorderBrush="{DynamicResource SearchCardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="18">
                                        <Grid Height="{Binding TimelineHeight}"
                                              Tag="{Binding}"
                                              Background="Transparent"
                                              ClipToBounds="True"
                                              AllowDrop="True"
                                              Drop="DayPlan_Drop">
                                            <ItemsControl ItemsSource="{Binding DataContext.AgendaDisplayGridSlots, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource HourStripeStyle}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <ItemsControl ItemsSource="{Binding NonWorkingTimeBlocks}"
                                                          IsHitTestVisible="False"
                                                          Panel.ZIndex="1">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Grid/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource NonWorkingTimeBlockStyle}"
                                                                Margin="{Binding TimelineMargin}"
                                                                Height="{Binding BlockHeight}">
                                                            <TextBlock Text="{Binding Label}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource SummaryValueBrush}"
                                                                       TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ShowLabel}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="Dépose les essais ici"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       IsHitTestVisible="False"
                                                       Panel.ZIndex="1">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding DisplaySegments.Count}" Value="0"/>
                                                                    <Condition Binding="{Binding IsWorkingDay}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <ItemsControl ItemsSource="{Binding DisplaySegments}"
                                                          PreviewMouseMove="AgendaList_PreviewMouseMove"
                                                          Panel.ZIndex="2">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Grid/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="VerticalAlignment" Value="Top"/>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource TimelineTaskCardStyle}"
                                                                Margin="{Binding TimelineMargin}"
                                                                Height="{Binding BlockHeight}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="6"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Border Background="{DynamicResource InfoCardAccentBrush}"
                                                                        CornerRadius="16,0,0,16"/>

                                                                <StackPanel Grid.Column="1"
                                                                            Margin="8,0,0,0">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" MinWidth="0"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding NomEssai}"
                                                                                   FontSize="12"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource PrimaryTitleBrush}"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <Border Grid.Column="1"
                                                                                Margin="8,0,0,0"
                                                                                Padding="7,3"
                                                                                Background="{DynamicResource SummaryWarmBackgroundBrush}"
                                                                                BorderBrush="{DynamicResource SummaryWarmBorderBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="10"
                                                                                VerticalAlignment="Top">
                                                                            <TextBlock Text="{Binding DureeLabel}"
                                                                                       FontSize="10"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="{DynamicResource SummaryWarmForegroundBrush}"/>
                                                                        </Border>
                                                                        <Button Grid.Column="2"
                                                                                Content="Retirer"
                                                                                Margin="8,0,0,0"
                                                                                VerticalAlignment="Top"
                                                                                ToolTip="Remettre dans À planifier"
                                                                                Style="{StaticResource MiniAgendaButtonStyle}"
                                                                                Click="RetirerEssaiAgenda_Click"/>
                                                                    </Grid>

                                                                    <StackPanel Margin="0,4,0,0"
                                                                                Orientation="Horizontal">
                                                                        <Grid>
                                                                            <Border Padding="7,3"
                                                                                    Background="{DynamicResource SearchInputBackgroundBrush}"
                                                                                    BorderBrush="{DynamicResource SearchInputBorderBrush}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="10"
                                                                                    Cursor="IBeam"
                                                                                    MouseLeftButtonDown="SegmentStartTime_MouseLeftButtonDown">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsEditingStartTime}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <TextBlock Text="{Binding StartTimeText}"
                                                                                           FontSize="11"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="{DynamicResource SummaryValueBrush}"/>
                                                                            </Border>

                                                                            <TextBox Text="{Binding StartTimeText, Mode=OneWay}"
                                                                                     PreviewKeyDown="SegmentTimeEdit_PreviewKeyDown"
                                                                                     LostFocus="SegmentStartTimeEdit_LostFocus">
                                                                                <TextBox.Style>
                                                                                    <Style TargetType="TextBox" BasedOn="{StaticResource TimeEditTextBoxStyle}">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsEditingStartTime}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBox.Style>
                                                                            </TextBox>
                                                                        </Grid>

                                                                        <TextBlock Text="-"
                                                                                   Margin="5,0"
                                                                                   FontSize="11"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                                   VerticalAlignment="Center"/>

                                                                        <Grid>
                                                                            <Border Padding="7,3"
                                                                                    Background="{DynamicResource SearchInputBackgroundBrush}"
                                                                                    BorderBrush="{DynamicResource SearchInputBorderBrush}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="10"
                                                                                    Cursor="IBeam"
                                                                                    MouseLeftButtonDown="SegmentEndTime_MouseLeftButtonDown">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsEditingEndTime}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <TextBlock Text="{Binding EndTimeText}"
                                                                                           FontSize="11"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="{DynamicResource SummaryValueBrush}"/>
                                                                            </Border>

                                                                            <TextBox Text="{Binding EndTimeText, Mode=OneWay}"
                                                                                     PreviewKeyDown="SegmentTimeEdit_PreviewKeyDown"
                                                                                     LostFocus="SegmentEndTimeEdit_LostFocus">
                                                                                <TextBox.Style>
                                                                                    <Style TargetType="TextBox" BasedOn="{StaticResource TimeEditTextBoxStyle}">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsEditingEndTime}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBox.Style>
                                                                            </TextBox>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding NomProduit}"
                                                                               Margin="0,3,0,0"
                                                                               FontSize="10"
                                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding NumeroProjet}"
                                                                               Margin="0,1,0,0"
                                                                               FontSize="10"
                                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="Dépasse la semaine"
                                                                               Margin="0,3,0,0"
                                                                               FontSize="10"
                                                                               Foreground="#D65C72">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsOverflow}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Border Background="{DynamicResource DataGridRowSelectedBrush}"
                                                    CornerRadius="18"
                                                    IsHitTestVisible="False">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWorkingDay}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="Journée non travaillée"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTitleBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
